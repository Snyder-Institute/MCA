  "associations": [
    {
      "association_text": "Enterococcus faecalis was isolated from a wound swab in a post-HSCT immunocompromised patient with B-cell ALL; treatment with cefepime was initiated but discontinued due to cefepime-induced neurotoxicity.",
      "content_hash": "20f4d782fe6c10dc2eec8bba94b3b0bb26b21e0922ae4dd0dea129cfa77ceb6d",
      "evidence_level": "E1",
      "evidence_type": "case report",
      "refs": [],
      "pmids": [
        40544256
      ]
    },
    {
      "association_text": "GF C57BL/6 mice monocolonized with E. faecalis (n=6–10) showed translocation to mesenteric veins, MLNs, and liver but did NOT develop gut barrier leakage (FITC-dextran not elevated), anti-RNA IgG, or anti-dsDNA IgG autoantibodies at 8 weeks post-colonization, in contrast to E. gallinarum-monocolonized mice; Th17 cells were not expanded in small intestinal lamina propria or MLNs (n=5 per group).",
      "content_hash": "fedfc396fbf0bbf60e7df3178279d695353ef7d2d7a1a7560af22ee035d8880f",
      "evidence_level": "E2",
      "evidence_type": "animal model",
      "refs": [
