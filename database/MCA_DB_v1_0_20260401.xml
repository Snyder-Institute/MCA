     <ref type="mesh" id="D064806" label="Dysbiosis"/>
    </AssocRefs>
    <Pmids>
     <pmid>36894652</pmid>
    </Pmids>
   </ClinicalAssociation>
   <ClinicalAssociation>
    <association_text>Enterococcaceae gut bloom in ICU patients was associated with nosocomial infections, particularly bloodstream infections and urinary tract infections attributed to Enterococcus species, implicating gut reservoir overgrowth in the pathogenesis of ICU-acquired Enterococcal infections.</association_text>
