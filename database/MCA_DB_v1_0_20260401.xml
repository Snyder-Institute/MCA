  <ClinicalAssociations>
   <ClinicalAssociation>
    <association_text>Enterobacteriaceae relative abundance was significantly elevated in critically ill ICU patients compared to healthy controls, representing the dominant bloom component of gut dysbiosis in critical illness as quantified by 16S rRNA sequencing of rectal swab samples.</association_text>
    <content_hash>a83c223d7eee5ed41a6ac5272d1b65caf0c8eaae2e8f0876bd59f3bcefda1c86</content_hash>
    <evidence_grade>E2</evidence_grade>
    <evidence_type>prospective cohort</evidence_type>
    <AssocRefs>
     <ref type="mesh" id="D016638" label="Critical Illness"/>
     <ref type="mesh" id="D064806" label="Dysbiosis"/>
    </AssocRefs>
    <Pmids>
     <pmid>36894652</pmid>
    </Pmids>
   </ClinicalAssociation>
   <ClinicalAssociation>
    <association_text>Higher Enterobacteriaceae relative abundance in ICU patients was associated with subsequent development of nosocomial infections; gut microbiota dysbiosis incorporating Enterobacteriaceae bloom contributed to a predictive microbiota-immune metasystem score for infection outcomes.</association_text>
    <content_hash>25a05ed6074d7ba0350ed6217f15cf49ab5bd188354c2e6d20a84b8b1c73578c</content_hash>
    <evidence_grade>E2</evidence_grade>
    <evidence_type>prospective cohort</evidence_type>
    <AssocRefs>
     <ref type="mesh" id="D003428" label="Cross Infection"/>
     <ref type="mesh" id="D016638" label="Critical Illness"/>
    </AssocRefs>
    <Pmids>
     <pmid>36894652</pmid>
    </Pmids>
   </ClinicalAssociation>
   <ClinicalAssociation>
    <association_text>Enterobacteriaceae bloom in ICU patients correlated with immune dysregulation markers (including impaired innate immune cell function) as part of a gut microbiota-immune metasystem that was disrupted in critical illness.</association_text>
    <content_hash>525d87faefe04b35caae0da65e78bcb934b7e78c0aeb3627852c77e0b7c78c61</content_hash>
